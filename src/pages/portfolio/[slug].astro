---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Carousel from '../../components/Carousel.astro';
import { SITE } from '../../config';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const work = (await getCollection('portfolio'))
    .filter((item) => import.meta.env.DEV || !item.data.draft);
  return work.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);

const pageUrl = new URL(`/portfolio/${item.id}/`, SITE.url).href;
const images = [item.data.cover, ...item.data.gallery.map((g) => g.src)].map(
  (src) => new URL(src, SITE.url).href
);

// A CreativeWork tells a crawler what this page IS — a designed book, made by
// a named person, in a named genre — rather than leaving it to guess from a
// title and some pictures. It is also the part a language model can quote.
const workLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  '@id': pageUrl,
  name: item.data.title,
  headline: item.data.title,
  description: item.data.summary,
  url: pageUrl,
  image: images,
  genre: item.data.category,
  dateCreated: String(item.data.year),
  creator: {
    '@type': 'Person',
    name: SITE.author,
    url: SITE.url,
    jobTitle: SITE.jobTitle,
  },
};
---
<BaseLayout
  title={`${item.data.title} — ${item.data.category}`}
  description={item.data.summary}
  ogType="article"
  ogImage={item.data.cover}
  jsonLd={workLd}
>
  <article>
    <p class="folio">{item.data.category}</p>
    <h1>{item.data.title}</h1>
    <img class="cover" src={item.data.cover} alt={`${item.data.title} — ${item.data.category.toLowerCase()} by ${SITE.author}`} width={item.data.coverWidth} height={item.data.coverHeight} decoding="async" />
    <div class="prose">
      <Content />
    </div>
    <Carousel items={item.data.gallery} title={item.data.title} />
  </article>
  <hr />
  <p><a href="/portfolio/">← All work</a> · <a href="/contact/">Commission something like this</a></p>
</BaseLayout>

<style>
  .cover { border: 1px solid var(--hairline); margin: 1.5rem 0 2rem; width: 100%; height: auto; }
</style>
