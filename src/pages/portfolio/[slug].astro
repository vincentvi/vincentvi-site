---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Carousel from '../../components/Carousel.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const work = (await getCollection('portfolio'))
    .filter((item) => import.meta.env.DEV || !item.data.draft);
  return work.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---
<BaseLayout title={item.data.title} description={item.data.summary} ogType="article" ogImage={item.data.cover}>
  <article>
    <p class="folio">{item.data.category}</p>
    <h1>{item.data.title}</h1>
    <img class="cover" src={item.data.cover} alt={item.data.title} width={item.data.coverWidth} height={item.data.coverHeight} decoding="async" />
    <div class="prose">
      <Content />
    </div>
    <Carousel items={item.data.gallery} title={item.data.title} />
  </article>
  <hr />
  <p><a href="/portfolio/">← All work</a> · <a href="/contact/">Commission something like this</a></p>
</BaseLayout>

<style>
  .cover { border: 1px solid var(--hairline); margin: 1.5rem 0 2rem; width: 100%; height: auto; }
</style>
